# --- Supabase (Postgres + Auth API) ---
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# 형식: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/prombutter
# Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API → Project API keys → anon public (OAuth·Auth API)
SUPABASE_ANON_KEY=your-anon-public-key
# Project Settings → API → Project API keys → service_role (서버 Admin·RLS 우회 — 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App JWT session (PromButter 자체 세션) ---
# 토큰 서명 비밀키 (예: openssl rand -hex 32). 환경마다 다른 값 사용
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# provider 토큰 DB 암호화 키 (Fernet). 미설정 시 access/refresh provider 토큰은 저장하지 않음
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_KEY=

# --- Supabase Google OAuth 연동 ---
# Google Cloud Console 에서 OAuth 클라이언트 생성 후
# Supabase Dashboard → Authentication → Providers → Google 에 Client ID/Secret 등록
# (앱은 Supabase Auth 를 경유하므로 GOOGLE_OAUTH_* 를 앱 env 에 둘 필요 없음)
#
# Redirect URLs (Supabase Authentication → URL Configuration):
#   - Site URL: http://localhost:3000
#   - Additional Redirect URLs:
#       http://localhost:8000/auth/oauth/callback
#       http://localhost:3000/auth/callback
OAUTH_CALLBACK_URL=http://localhost:8000/auth/oauth/callback
OAUTH_FRONTEND_REDIRECT=http://localhost:3000/auth/callback
OAUTH_ALLOWED_REDIRECTS=http://localhost:3000,https://frontend-prombutters-projects.vercel.app

# --- GCP Cloud Storage (파일 저장 연동 — 미리 셋팅) ---
# GCS 전용 서비스 계정 JSON 경로 (Firebase 아님)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-storage-sa.json
GCS_BUCKET=prombutter-assets

# --- App ---
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://frontend-prombutters-projects.vercel.app
ALLOWED_HOSTS=localhost,127.0.0.1

# Production/staging must set:
# APP_ENV=production
# CORS_ORIGINS=https://<frontend-domain>
# ALLOWED_HOSTS=<api-domain>
# DATABASE_URL=<non-local managed database URL>
# JWT_SECRET=<strong secret>
# SUPABASE_URL / SUPABASE_ANON_KEY
