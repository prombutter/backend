# --- Supabase Postgres ---
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# 형식: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/prombutter

# Project Settings → API (OAuth·Admin 등 사용 시)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://frontend-prombutters-projects.vercel.app

# --- GCP (Google Cloud Platform) ---
# GCP Console → 프로젝트 ID 와 Cloud Storage 버킷 이름
GCP_PROJECT_ID=prombutter-xxxxx
GCP_STORAGE_BUCKET=prombutter-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-storage-sa.json

# --- Security / Auth (앱 JWT — python-jose) ---
# 필수: JWT 서명 시크릿 (openssl rand -hex 32)
SECRET_KEY=your_super_secret_key_here
COOKIE_SECURE=False
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Supabase Google OAuth (선택 — Auth 경유 소셜 로그인 연동 시) ---
# Dashboard → Authentication → Providers → Google + URL Configuration
OAUTH_CALLBACK_URL=http://localhost:8000/auth/oauth/callback
OAUTH_FRONTEND_REDIRECT=http://localhost:3000/auth/callback
OAUTH_ALLOWED_REDIRECTS=http://localhost:3000,https://frontend-prombutters-projects.vercel.app
OAUTH_TOKEN_KEY=
