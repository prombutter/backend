# --- Supabase (Postgres + API) ---
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# 형식: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/prombutter
# Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API → Project API keys → anon public (클라이언트 노출 가능·RLS 적용)
SUPABASE_ANON_KEY=your-anon-public-key
# Project Settings → API → Project API keys → service_role (서버 전용·RLS 우회·클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Auth (FastAPI 자체 JWT/세션 인증 — Firebase 미사용) ---
# 토큰 서명 비밀키 (예: openssl rand -hex 32). 환경마다 다른 값 사용
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Google 소셜 로그인 (스키마 user_identities.AUTH_PROVIDER='GOOGLE' — 자체 OAuth)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- GCP Cloud Storage (파일 저장 연동 — 미리 셋팅) ---
# GCS 전용 서비스 계정 JSON 경로 (Firebase 아님)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-storage-sa.json
GCS_BUCKET=prombutter-assets

# --- App ---
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://frontend-prombutters-projects.vercel.app
ALLOWED_HOSTS=localhost,127.0.0.1

# Production/staging must set:
# APP_ENV=production
# CORS_ORIGINS=https://<frontend-domain>
# ALLOWED_HOSTS=<api-domain>
# DATABASE_URL=<non-local managed database URL>
